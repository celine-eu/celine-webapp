CELINE_OIDC_CLIENT_ID=
CELINE_OIDC_CLIENT_SECRET=

# ── Dataspace data sharing ────────────────────────────────────────────────────
#
# Off by default. The dataspace may not be deployed for some time, and a member
# seeing a sharing screen whose decisions take effect nowhere is worse than not
# seeing one. When false the API answers 404 and the UI hides the section.
#
# DATA_SHARING_ENABLED=false
#
# Where a member's decisions live. The identity registry resolves their DID and
# credential from their email; the connector holds the consent rows; provenance
# serves their own history. Every consent call is made with the member's own
# credential — the service account below only resolves which one is theirs.
#
# IDENTITY_REGISTRY_URL=http://host.docker.internal:30005
# DS_CONNECTOR_URL=http://host.docker.internal:30001
# DS_NS_URL=                      # defaults to the connector's /ns path
# DS_PROVENANCE_URL=http://host.docker.internal:30000
#
# DS_RESOLVE_CLIENT_ID=svc-celine-webapp    # needs identity-registry.resolve
# DS_RESOLVE_CLIENT_SECRET=
